<%
const {
    name = '',
    email = '',
    startDate = '',
    guests = '',
    errors = [],
    success = false,
} = locals;
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        reservations
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <form method="POST">
        <label for="name">name</label>
        <input type="text" name="name" value="<%=name%>" required min="1">

        <label for="email">email</label>
        <input type="email" name="email" value="<%=email%>" required>

        <label for="startDate">start date</label>
        <input type="datetime-local" name="startDate" value="<%=startDate%>" required min="<%=new Date().toISOString().split('T')[0]%>">

        <label for="guests">(number of) guests</label>
        <input type="number" name="guests" value="<%=guests%>" required min="1" max="10">

        <input type="submit">
    </form>
    <% for (const e of errors) { %>
        <p><%=e%></p>
    <% } %>
    <% if (success) { %>
        <p>reservation created successfully</p>
    <% } %>
</body>
</html>
